# FGSM with Feature Squeezing Defense
print("\nRunning FGSM with Feature Squeezing experiments")

model.eval()
fgsm_defense_results = []

# Test FGSM with defense for each epsilon
for epsilon in epsilons:
    correct = 0
    total = 0
    confidence_change = 0.0

    for index, (images, labels) in enumerate(test_loader):
        # Perform FGSM attack
        attacked_images, original_predictions, _, original_confidence, _ = fgsm(model, images, labels, epsilon, device)

        # Apply feature squeezing defense
        defended_images = feature_squeeze(attacked_images, bit_depth=5)

        # Get predictions from the defended images
        defended_outputs = model(defended_images.to(device))
        defended_predictions = defended_outputs.argmax(dim=1)
        defended_confidence = F.softmax(defended_outputs, dim=1).max(dim=1)[0]

        correct += (defended_predictions == labels.to(device)).sum().item()
        total += labels.size(0)
        confidence_change += (original_confidence - defended_confidence).sum().item()

    accuracy = 100 * correct / total
    success_rate = 100 - accuracy
    avg_conf_change = confidence_change / total

    fgsm_defense_results.append({
        'epsilon': epsilon,
        'accuracy': accuracy
    })

    print(f"Epsilon {epsilon}: Accuracy = {accuracy:.2f}% | Success Rate = {success_rate:.2f}% | Average Confidence Change = {avg_conf_change:.4f}")


