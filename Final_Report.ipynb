# Function for creating the FGSM attack example
def fgsm(model, images, labels, epsilon, device):
    images = images.to(device)
    labels = labels.to(device)

    images.requires_grad = True

    # Go through all of the original images and calculate the loss
    outputs = model(images)
    original_predictions = outputs.argmax(dim=1)
    original_confidences = F.softmax(outputs, dim=1).max(dim=1)[0]

    loss = criterion(outputs, labels)

    # Get their gradients and sign
    model.zero_grad()
    loss.backward()

    data_gradients = images.grad.data
    sign_gradients = data_gradients.sign()

    # Make the adversarial attack
    perturbed_images = images + epsilon * sign_gradients
    perturbed_images = torch.clamp(perturbed_images, 0, 1)

    # Go through all of the malicious images
    adversarial_output = model(perturbed_images.detach())
    adversarial_predictions = adversarial_output.argmax(dim=1)
    adversarial_confidences = F.softmax(adversarial_output, dim=1).max(dim=1)[0]


    return (perturbed_images.detach(),
            original_predictions,
            adversarial_predictions,
            original_confidences.detach(),
            adversarial_confidences.detach())

# Function for making the PGD example
def pgd(model, images, labels, epsilon, alpha, iterations, device):
    images = images.to(device)
    labels = labels.to(device)

    # Get the original predictions and images
    outputs = model(images)
    original_predictions = outputs.argmax(dim=1)
    original_confidences = F.softmax(outputs, dim=1).max(dim=1)[0]
    attacked_images = images.clone().detach()

    # Perform the attack per iteration
    for i in range(iterations):
        attacked_images.requires_grad = True

        # Go through all of the original images and calculate the loss
        outputs = model(attacked_images)
        loss = criterion(outputs, labels)
        model.zero_grad()
        loss.backward()

        data_grad = attacked_images.grad.data
        attacked_images = attacked_images + alpha * data_grad.sign()

        perturbation = torch.clamp(attacked_images - images, -epsilon, epsilon)
        attacked_images = torch.clamp(images + perturbation, 0, 1).detach()

    # Get the attack predictions
    adversarial_output = model(attacked_images)
    adversarial_predictions = adversarial_output.argmax(dim=1)
    adversarial_confidences = F.softmax(adversarial_output, dim=1).max(dim=1)[0]

    return (attacked_images.detach(),
            original_predictions,
            adversarial_predictions,
            original_confidences.detach(),
            adversarial_confidences.detach())

# Feature squeezing defense method
def feature_squeeze(images, bit_depth=5):
    max_value = 2 ** bit_depth

    squeezed = torch.round(images * max_value) / max_value

    squeezed = torch.clamp(squeezed, 0, 1)

    return squeezed

# Defining the LeNet5 model
class LeNet5(nn.Module):
    def __init__(self, num_classes=10):
        super().__init__()
        self.conv1 = nn.Conv2d(1, 6, kernel_size=5)
        self.pool1 = nn.AvgPool2d(2, 2)
        self.conv2 = nn.Conv2d(6, 16, kernel_size=5)
        self.pool2 = nn.AvgPool2d(2, 2)
        self.fc1   = nn.Linear(16*4*4, 120)
        self.fc2   = nn.Linear(120, 84)
        self.fc3   = nn.Linear(84, num_classes)

    def forward(self, x):
        x = torch.tanh(self.conv1(x))
        x = self.pool1(x)
        x = torch.tanh(self.conv2(x))
        x = self.pool2(x)
        x = x.view(x.size(0), -1)
        x = torch.tanh(self.fc1(x))
        x = torch.tanh(self.fc2(x))
        x = self.fc3(x)
        return x

if torch.cuda.is_available():
    device = torch.device("cuda")
else:
    device = torch.device("cpu")

device = torch.device("cuda")
model = LeNet5(num_classes=10).to(device)

# Path
data_directory = "/content/data"

# Variables
batch_size = 64
criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model.parameters(), lr=0.001)
rounds = 2
epsilons = [0.0, 0.05, 0.1, 0.2, 0.3]
pgd_iterations = 40
pgd_alpha = 0.01
results = 0

transform = transforms.Compose([
    transforms.ToTensor(),
])


# Build the training and test datasets
train_ds = datasets.MNIST(root=data_directory, download=True, train=True, transform=transform)
test_ds  = datasets.MNIST(root=data_directory, download=True, train=False, transform=transform)


# Load the training and test data
train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)
test_loader  = DataLoader(test_ds, batch_size=batch_size)

# Training our model
for round in range(rounds):
    model.train()
    running_loss = 0.0

    # Pass in all of the images
    for images, labels in train_loader:
        images, labels = images.to(device), labels.to(device)
        optimizer.zero_grad()
        outputs = model(images)
        loss = criterion(outputs, labels)
        loss.backward()
        optimizer.step()
        running_loss += loss.item()


# Testing the accuracy of our model
model.eval()
correct = total = 0
with torch.no_grad():
    for images, labels in test_loader:
        images, labels = images.to(device), labels.to(device)
        preds = model(images).argmax(1)
        correct += (preds == labels).sum().item()
        total   += labels.size(0)
print(f"Test accuracy: {100*correct/total:.2f}%")

