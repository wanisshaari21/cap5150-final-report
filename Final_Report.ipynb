# FGSM experiments
print("Running FGSM experiments")

model.eval()
results = []
saved_image = None
# Test FGSM for each different epsilon values
for epsilon in epsilons:
    correct = 0
    total = 0
    confidence_change = 0.0

    for index, (images, labels) in enumerate(test_loader):
        # Perform FGSM on each image
        attacked_images, original_predictions, attacked_predictions, original_confidence, attacked_confidence = fgsm(model, images, labels, epsilon, device)

        correct += (attacked_predictions == labels.to(device)).sum().item()
        total += labels.size(0)
        confidence_change += (original_confidence - attacked_confidence).sum().item()

        # Save one image to print it
        if index == 0 and saved_image is None:
            saved_image = (images[0:1].cpu(), labels[0:1])

    accuracy = 100 * correct / total
    success_rate = 100 - accuracy
    avg_conf_change = confidence_change / total

    results.append({
        'epsilon': epsilon,
        'accuracy': accuracy
    })

    # Print results
    print(f"Epsilon {epsilon}: Accuracy = {accuracy:.2f}% | Success Rate = {success_rate:.2f}% | Average Confidence Change = {avg_conf_change:.4f}")


# Show the one image as example for epsilon 0.3
images, labels = next(iter(test_loader))
perturbed_imgs, _, adv_preds, _, _ = fgsm(model, images, labels, 0.3, device)
fig, axes = plt.subplots(1, 2, figsize=(6, 3))
axes[0].imshow(images[0].squeeze(), cmap='gray')
axes[0].set_title(f'The original predicted: {labels[0].item()}')
axes[0].axis('off')
axes[1].imshow(perturbed_imgs[0].cpu().squeeze(), cmap='gray')
axes[1].set_title(f'The after predicted: {adv_preds[0].item()}')
axes[1].axis('off')

plt.suptitle('FGSM example attack using epsilon = 0.3', fontsize=12)
plt.tight_layout()
plt.show()

# Making the plot for FGSM
epsilon_values = [r['epsilon'] for r in results]
accuracy = [r['accuracy'] for r in results]

plt.figure(figsize=(8, 5))
plt.plot(epsilon_values, accuracy, 'bo-', linewidth=2, markersize=8, label='After Attack')

plt.xlabel('Epsilon', fontsize=12)
plt.ylabel('Accuracy', fontsize=12)
plt.title('FGSM Adversarial Attack', fontsize=14)
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

